# Copy to .env to override the defaults. Everything here is optional.
# Restart the API and the worker after changing a value.

# SQLite database location. Default: backend/data/monologue_coach.db
DATABASE_URL=

# Folder for uploaded and kept audio. Default: backend/data
DATA_DIR=

# Extra browser origins allowed to call the API (comma-separated).
# Any http://localhost:<port> or http://127.0.0.1:<port> origin is always allowed.
FRONTEND_ORIGINS=

# Largest upload, in megabytes. Default: 50
MAX_UPLOAD_MB=

# Longest recording, in minutes. Default: 10
MAX_AUDIO_MINUTES=

# Speech-recognition model: tiny, base, small, medium or large-v3. Default: small
# After changing it, download the new model: uv run python -m app.speech_model download
WHISPER_MODEL=

# How the model's numbers are stored in memory. Default: int8 (fastest on a laptop CPU)
WHISPER_COMPUTE_TYPE=

# How long the audio of a failed job is kept so that Retry can work, in hours. Default: 24
FAILED_AUDIO_RETENTION_HOURS=

# How many times a job is started again after the worker died while running it. Default: 2
MAX_JOB_ATTEMPTS=

# How often the worker looks for a new job, in seconds. Default: 1
WORKER_POLL_SECONDS=

# Worker log detail: INFO or DEBUG. DEBUG includes error tracebacks. Default: INFO
LOG_LEVEL=
